s"},"<list-style-image>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"}],description:"CSS list-style-image: none or URL"},"<alpha-value>":{anyOf:[{$ref:"#/definitions/<number>"},{$ref:"#/definitions/<percentage>"}],description:"CSS alpha value for colors: number (0-1) or percentage"},"<absolute-size>":{type:"string",enum:["xx-small","x-small","small","medium","large","x-large","xx-large","xxx-large"],description:"CSS absolute font sizes"},"<relative-size>":{type:"string",enum:["larger","smaller"],description:"CSS relative font sizes"},"<angle-percentage>":{anyOf:[{$ref:"#/definitions/<angle>"},{$ref:"#/definitions/<percentage>"}],description:"CSS angle or percentage"},"<number-percentage>":{anyOf:[{$ref:"#/definitions/<number>"},{$ref:"#/definitions/<percentage>"}],description:"CSS number or percentage"},"<time-percentage>":{anyOf:[{$ref:"#/definitions/<time>"},{$ref:"#/definitions/<percentage>"}],description:"CSS time or percentage"},"<frequency-percentage>":{anyOf:[{$ref:"#/definitions/<frequency>"},{$ref:"#/definitions/<percentage>"}],description:"CSS frequency or percentage"},"<baseline-position>":{type:"string",pattern:"^(first\\s+baseline|last\\s+baseline|baseline)$",description:"CSS baseline position: baseline, first baseline, or last baseline"},"<content-distribution>":{type:"string",enum:["space-between","space-around","space-evenly","stretch"],description:"CSS content distribution values for alignment"},"<content-position>":{type:"string",enum:["center","start","end","flex-start","flex-end"],description:"CSS content position values for alignment"},"<self-position>":{type:"string",enum:["center","start","end","self-start","self-end","flex-start","flex-end"],description:"CSS self position values for alignment"},"<overflow-position>":{type:"string",enum:["unsafe","safe"],description:"CSS overflow position modifiers"},"<justify-content>":{anyOf:[{$ref:"#/definitions/<normal>"},{$ref:"#/definitions/<content-distribution>"},{$ref:"#/definit