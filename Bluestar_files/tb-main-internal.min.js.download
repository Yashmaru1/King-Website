a.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.Stroke":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Color"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<paint>",format:"css-stroke"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.StrokeWidth":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.LengthPercentage"},{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Length"},{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Percentage"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<length-percentage>",format:"css-stroke-width"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.StrokeOpacity":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Number"},{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Percentage"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<alpha-value>",format:"css-stroke-opacity"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.Display":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<display>",format:"css-display"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.Filter":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn: