storical-ligatures","no-historical-ligatures"],description:"CSS historical ligature values"},"<contextual-alt-values>":{type:"string",enum:["contextual","no-contextual"],description:"CSS contextual alternates values"},"<composite-style>":{type:"string",enum:["clear","copy","source-over","source-in","source-out","source-atop","destination-over","destination-in","destination-out","destination-atop","xor"],description:"CSS composite style values"},"<compositing-operator>":{type:"string",enum:["add","subtract","intersect","exclude"],description:"CSS compositing operator values"},"<axis>":{type:"string",enum:["block","inline","x","y"],description:"CSS axis values"},"<scroller>":{type:"string",enum:["root","nearest","self"],description:"CSS scroller values"},"<try-size>":{type:"string",enum:["most-width","most-height","most-block-size","most-inline-size"],description:"CSS try size values"},"<try-tactic>":{type:"string",enum:["flip-block","flip-inline","flip-start"],description:"CSS try tactic values"},"<font>":{type:"string",description:"CSS font shorthand. Complex syntax combining font-style, font-variant, font-weight, font-size/line-height, and font-family cannot be fully validated with regex."},"<font-variant>":{type:"string",description:"CSS font-variant shorthand. Complex syntax combining normal, small-caps, and various feature values cannot be fully validated with regex."},"<flex-direction>":{type:"string",enum:["row","row-reverse","column","column-reverse"],description:"CSS flex-direction values"},"<gap>":{type:"string",pattern:"^(normal|0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))(\\s|$){1,2}",description:"CSS gap values"},"<padding>":{type:"string",pattern:"^((0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s*){1,4}$",description:"CSS padding values"},"<padding-top>":{$ref:"#/definitions/<positive-length