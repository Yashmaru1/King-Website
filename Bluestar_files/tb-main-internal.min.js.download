ues for alignment"},"<content-position>":{type:"string",enum:["center","start","end","flex-start","flex-end"],description:"CSS content position values for alignment"},"<self-position>":{type:"string",enum:["center","start","end","self-start","self-end","flex-start","flex-end"],description:"CSS self position values for alignment"},"<overflow-position>":{type:"string",enum:["unsafe","safe"],description:"CSS overflow position modifiers"},"<justify-content>":{anyOf:[{$ref:"#/definitions/<normal>"},{$ref:"#/definitions/<content-distribution>"},{$ref:"#/definitions/<content-position>"},{type:"string",enum:["left","right"]},{type:"string",pattern:"^(safe|unsafe)?\\s+(left|right|center|start|end|flex-start|flex-end)$"}],description:"CSS justify-content values"},"<visual-box>":{type:"string",enum:["content-box","padding-box","border-box"],description:"CSS visual box types"},"<shape-box>":{anyOf:[{$ref:"#/definitions/<visual-box>"},{type:"string",enum:["margin-box"]}],description:"CSS shape box types"},"<geometry-box>":{anyOf:[{$ref:"#/definitions/<shape-box>"},{type:"string",enum:["fill-box","stroke-box","view-box"]}],description:"CSS geometry box types including visual box and additional geometry boxes"},"<paint-box>":{anyOf:[{$ref:"#/definitions/<visual-box>"},{type:"string",enum:["fill-box","stroke-box"]}],description:"CSS paint box types"},"<coord-box>":{anyOf:[{$ref:"#/definitions/<paint-box>"},{type:"string",enum:["view-box"]}],description:"CSS coordinate box types (paint-box or view-box)"},"<mask-clip>":{anyOf:[{$ref:"#/definitions/<coord-box>"},{type:"string",enum:["no-clip"]}],description:"CSS mask-clip values including coord-box and no-clip"},"<mask-origin>":{$ref:"#/definitions/<coord-box>",description:"CSS mask-origin values (coord-box)"},"<generic-family>":{type:"string",enum:["serif","sans-serif","monospace","cursive","fantasy","system-ui","ui-serif","ui-sans-serif","ui-monospace","ui-rounded","math","emoji","fangsong"],description:"CSS generic font families"},"<family-name>":{anyOf:[{$ref:"#/definitions/<string>"},{$ref:"#/definitions/<custom-ident>"}],description:"CSS font family name: quoted string or unquoted identifier"},"<system-family-name>":{type:"string",enum:["caption","icon","menu","message-box","small-caption","status-bar"],description:"CSS system font family names"},"<font-stretch-absolute>":{anyOf:[{type:"string",enum:["normal","ultra-condensed","extra-condensed","condensed","semi-condensed","semi-expanded","expanded","extra-expanded","ultra-expanded"]},{$ref:"#/definitions/<percentage>"}],description:"CSS font stretch absolute values"},"<font-weight-absolute>":{anyOf:[{type:"string",enum:["normal","bold"]},{type:"string",pattern:"^(100|200|300|400|500|600|700|800|900|[1-9][0-9]{0,2})$"}],description:"CSS font weight absolute values: normal, bold, or number 1-1000"},"<grid-line>":{type:"string",description:"CSS grid line: auto, custom identifier, integer with optional identifier, or span notation. Complex syntax cannot be fully validated with regex."},"<track-breadth>":{anyOf:[{$ref:"#/definitions/<length-percentage>"},{$ref:"#/definitions/<flex>"},{type:"string",enum:["min-content","max-content","auto"]}],description:"CSS grid track breadth"},"<inflexible-breadth>":{anyOf:[{$ref:"#/definitions/<length-percentage>"},{type:"string",enum:["min-content","max-content","auto"]}],description:"CSS inflexible breadth (track breadth without flex)"},"<track-size>":{type:"string",description:"CSS grid track size: track-breadth, minmax(), or fit-content(). Complex syntax cannot be fully validated with regex."},"<easing-function>":{anyOf:[{$ref:"#/definitions/<timing-function>"},{type:"string",pattern:"^linear\\(.*\\)$",description:"Linear easing function - arguments cannot be fully validated with regex"},{type:"string",pattern:"^steps\\(\\s*\\d+\\s*(,\\s*(start|end|jump-start|jump-end|jump-none|jump-both)\\s*)?\\)$"}],description:"CSS easing functions including cubic-bezier, steps, and linear"},"<single-animation-direction>":{type:"string",enum:["normal","reverse","alternate","alternate-reverse"],description:"CSS animation direction values"},"<single-animation-fill-mode>":{type:"string",enum:["none","forwards","backwards","both"],description:"CSS animation fill mode values"},"<single-animation-play-state>":{type:"string",enum:["running","paused"],description:"CSS animation play state values"},"<single-animation-iteration-count>":{anyOf:[{$ref:"#/definitions/<number>"},{type:"string",enum:["infinite"]}],description:"CSS animation iteration count: number or infinite"},"<keyframes-name>":{anyOf:[{$ref:"#/definitions/<custom-ident>"},{$ref:"#/definitions/<string>"}],description:"CSS keyframes name: identifier or string"},"<single-transition-property>":{anyOf:[{type:"string",enum:["all"]},{$ref:"#/definitions/<custom-ident>"}],description:"CSS transition property: all or property name"},"<quote>":{type:"string",enum:["open-quote","close-quote","no-open-quote","no-close-quote"],description:"CSS quote values for generated content"},"<counter-style-name>":{anyOf:[{$ref:"#/definitions/<custom-ident>"},{type:"string",enum:["decimal","decimal-leading-zero","lower-roman","upper-roman","lower-greek","lower-latin","upper-latin","armenian","georgian","lower-alpha","upper-alpha","disc","circle","square","none"]}],description:"CSS counter style: predefined or custom identifier"},"<ratio>":{type:"string",pattern:"^\\d+(\\.\\d+)?\\s*/\\s*\\d+(\\.\\d+)?$",description:"CSS ratio: number/number"},"<dasharray>":{type:"string",description:"CSS dash array for stroke-dasharray. Complex syntax with multiple length/percentage/number values cannot be fully validated with regex."},"<paint>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<color>"},{$ref:"#/definitions/<url>"}],description:"CSS paint values for SVG: none, color, URL, or context keywords"},"<overflow-wrap>":{type:"string",enum:["normal","break-word","anywhere"],description:"CSS overflow-wrap values (same as word-wrap)"},"<text-decoration-thickness>":{anyOf:[{$ref:"#/definitions/<auto>"},{$ref:"#/definitions/<positive-length>"},{$ref:"#/definitions/<positive-percentage>"},{type:"string",enum:["from-font"]}],description:"CSS text decoration thickness"},"<text-underline-offset>":{anyOf:[{$ref:"#/definitions/<auto>"},{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"}],description:"CSS text underline offset"},"<text-emphasis-style>":{anyOf:[{$ref:"#/definitions/<none>"},{type:"string",enum:["filled","open","dot","circle","double-circle","triangle","sesame"]},{$ref:"#/definitions/<string>"}],description:"CSS text emphasis style"},"<mask-composite>":{type:"string",enum:["add","subtract","intersect","exclude"],description:"CSS mask composite operation values"},"<mask-mode>":{type:"string",enum:["alpha","luminance","match-source"],description:"CSS mask mode values"},"<clip-path>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<url>"},{$ref:"#/definitions/<basic-shape>"}],description:"CSS clip-path: none, URL, or basic shape"},"<shape-outside>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"},{$ref:"#/definitions/<basic-shape>"}],description:"CSS shape-outside: none, image, or basic shape"},"<intrinsic-size-keyword>":{type:"string",enum:["auto","min-content","max-content","fit-content"],description:"CSS intrinsic sizing keywords"},"<step-position>":{type:"string",enum:["jump-start","jump-end","jump-none","jump-both","start","end"],description:"CSS step position for steps() timing function"},"<system-color>":{type:"string",enum:["AccentColor","AccentColorText","ActiveText","ButtonBorder","ButtonFace","ButtonText","Canvas","CanvasText","Field","FieldText","GrayText","Highlight","HighlightText","LinkText","Mark","MarkText","SelectedItem","SelectedItemText","VisitedText"],description:"CSS system colors"},"<deprecated-system-color>":{type:"string",enum:["ActiveBorder","ActiveCaption","AppWorkspace","Background","ButtonHighlight","ButtonShadow","CaptionText","InactiveBorder","InactiveCaption","InactiveCaptionText","InfoBackground","InfoText","Menu","MenuText","Scrollbar","ThreeDDarkShadow","ThreeDFace","ThreeDHighlight","ThreeDLightShadow","ThreeDShadow","Window","WindowFrame","WindowText"],description:"CSS deprecated system colors"},"<bg-size>":{anyOf:[{$ref:"#/definitions/<positive-length-percentage>"},{type:"string",enum:["auto","cover","contain"]},{type:"string",pattern:"^(auto|calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))(\\s+(auto|calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))?)$",description:"complex syntax with multiple values that cannot be fully validated with regex"}],description:"CSS background-size values"},"<bg-position>":{type:"string",description:"CSS background-position values. Complex syntax with multiple position values and combinations cannot be fully validated with regex."},"<bg-clip>":{anyOf:[{$ref:"#/definitions/<visual-box>"},{type:"string",enum:["text"]}],description:"CSS background-clip values"},"<bg-image>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"}],description:"CSS background-image values"},"<hue>":{anyOf:[{$ref:"#/definitions/<number>"},{$ref:"#/definitions/<angle>"}],description:"CSS hue value: number or angle"},"<radial-shape>":{type:"string",enum:["circle","ellipse"],description:"CSS radial gradient shape"},"<radial-extent>":{type:"string",enum:["closest-corner","closest-side","farthest-corner","farthest-side"],description:"CSS radial gradient extent"},"<side-or-corner>":{type:"string",pattern:"^(left|right|top|bottom)$|^(left|right)\\s+(top|bottom)$|^(top|bottom)\\s+(left|right)$",description:"CSS gradient side or corner direction"},"<color-stop-length>":{anyOf:[{$ref:"#/definitions/<length-percentage>"},{type:"string",pattern:"^\\d+(\\.\\d+)?%\\s+\\d+(\\.\\d+)?%$"}],description:"CSS color stop length: single or double length-percentage"},"<color-stop-angle>":{anyOf:[{$ref:"#/definitions/<angle-percentage>"},{type:"string",pattern:"^\\d+(\\.\\d+)?deg\\s+\\d+(\\.\\d+)?deg$"}],description:"CSS color stop angle: single or double angle-percentage"},"<masking-mode>":{type:"string",enum:["alpha","luminance","match-source"],description:"CSS masking mode values"},"<mask-reference>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"},{$ref:"#/definitions/<url>"}],description:"CSS mask reference values"},"<mask>":{type:"string",description:"CSS mask shorthand. Complex syntax combining multiple mask layers with mask-image, mask-mode, mask-position, mask-size, mask-repeat, mask-origin, mask-clip, and mask-composite cannot be fully validated with regex."},"<outline-line-style>":{type:"string",enum:["none","dotted","dashed","solid","double","groove","ridge","inset","outset"],description:"CSS outline line style values"},"<counter-name>":{anyOf:[{$ref:"#/definitions/<custom-ident>"},{type:"string",enum:["list-item"]}],description:"CSS counter name: custom identifier or list-item"},"<symbol>":{anyOf:[{$ref:"#/definitions/<string>"},{$ref:"#/definitions/<image>"},{$ref:"#/definitions/<custom-ident>"}],description:"CSS symbol values for counters"},"<symbols-type>":{type:"string",enum:["cyclic","numeric","alphabetic","symbolic","fixed"],description:"CSS symbols() function type"},"<feature-tag-value>":{type:"string",description:"CSS font feature tag value. Complex syntax with string and optional integer/keyword cannot be fully validated with regex."},"<east-asian-variant-values>":{type:"string",enum:["jis78","jis83","jis90","jis04","simplified","traditional"],description:"CSS East Asian variant values"},"<east-asian-width-values>":{type:"string",enum:["full-width","proportional-width"],description:"CSS East Asian width values"},"<numeric-figure-values>":{type:"string",enum:["lining-nums","oldstyle-nums"],description:"CSS numeric figure values"},"<numeric-fraction-values>":{type:"string",enum:["diagonal-fractions","stacked-fractions"],description:"CSS numeric fraction values"},"<numeric-spacing-values>":{type:"string",enum:["proportional-nums","tabular-nums"],description:"CSS numeric spacing values"},"<common-lig-values>":{type:"string",enum:["common-ligatures","no-common-ligatures"],description:"CSS common ligature values"},"<discretionary-lig-values>":{type:"string",enum:["discretionary-ligatures","no-discretionary-ligatures"],description:"CSS discretionary ligature values"},"<historical-lig-values>":{type:"string",enum:["historical-ligatures","no-historical-ligatures"],description:"CSS historical ligature values"},"<contextual-alt-values>":{type:"string",enum:["contextual","no-contextual"],description:"CSS contextual alternates values"},"<composite-style>":{type:"string",enum:["clear","copy","source-over","source-in","source-out","source-atop","destination-over","destination-in","destination-out","destination-atop","xor"],description:"CSS composite style values"},"<compositing-operator>":{type:"string",enum:["add","subtract","intersect","exclude"],description:"CSS compositing operator values"},"<axis>":{type:"string",enum:["block","inline","x","y"],description:"CSS axis values"},"<scroller>":{type:"string",enum:["root","nearest","self"],description:"CSS scroller values"},"<try-size>":{type:"string",enum:["most-width","most-height","most-block-size","most-inline-size"],description:"CSS try size values"},"<try-tactic>":{type:"string",enum:["flip-block","flip-inline","flip-start"],description:"CSS try tactic values"},"<font>":{type:"string",description:"CSS font shorthand. Complex syntax combining font-style, font-variant, font-weight, font-size/line-height, and font-family cannot be fully validated with regex."},"<font-variant>":{type:"string",description:"CSS font-variant shorthand. Complex syntax combining normal, small-caps, and various feature values cannot be fully validated with regex."},"<flex-direction>":{type:"string",enum:["row","row-reverse","column","column-reverse"],description:"CSS flex-direction values"},"<gap>":{type:"string",pattern:"^(normal|0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))(\\s|$){1,2}",description:"CSS gap values"},"<padding>":{type:"string",pattern:"^((0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s*){1,4}$",description:"CSS padding values"},"<padding-top>":{$ref:"#/definitions/<positive-length-percentage>",description:"CSS padding-top values"},type:"object"}},"cssPropertySchemas.json":{$id:"urn:dm:schemas:cssPropertySchemas.json",title:"CSS Property Schemas",description:"Individual JSON Schema definitions for CSS property value types used within Wix",definitions:{"CSS.Color":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<color>",format:"css-color"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.BlendMode":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<blend-mode>",format:"css-blend-mode"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.Angle":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<var()>"},{type:"string",$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<angle>",format:"css-angle"},{$ref:"urn:dm:schemas:css-value-definitions.schema.json#/definitions/<global-values>"}]},{maxLength:150}]},"CSS.LengthPercentage":{allOf:[{anyOf:[{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/CSS.Length"},{$ref:"urn:dm:schemas:cssPropertySchemas.json#/definitions/C