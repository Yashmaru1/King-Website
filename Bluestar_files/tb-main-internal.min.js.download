.root{
    -st-extends: StylableButton;
    transition: all 0.2s ease, visibility 0s;
    background: value(site_1_5)
}
.root:hover{
    border: 1px solid value(site_1_5);
    background: value(site_1_1)
}
.root:hover::label{
    color: value(site_1_5)
}
.root:disabled{
    background: #E2E2E2
}
.root:disabled::label{
    color: #8F8F8F
}
.root:disabled::icon{
    fill: #8F8F8F
}
.root::container{
    transition: inherit
}
.root::label{
    transition: inherit;
    font-family: futura-lt-w01-book,sans-serif;
    margin: 0px 4px 0px 0px;
    font-size: 14px;
    letter-spacing: 0.1em;
    -st-mixin: font_8;
    color: value(site_1_1)
}
.root::icon{
    transition: inherit;
    width: 10px;
    height: 10px;
    margin: 0px 0px 0px 4px;
    fill: value(site_1_1);
    display: none
}
.root:hover::icon{
    fill: value(site_1_5)
