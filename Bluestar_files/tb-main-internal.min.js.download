ption:"CSS animation play state values"},"<single-animation-iteration-count>":{anyOf:[{$ref:"#/definitions/<number>"},{type:"string",enum:["infinite"]}],description:"CSS animation iteration count: number or infinite"},"<keyframes-name>":{anyOf:[{$ref:"#/definitions/<custom-ident>"},{$ref:"#/definitions/<string>"}],description:"CSS keyframes name: identifier or string"},"<single-transition-property>":{anyOf:[{type:"string",enum:["all"]},{$ref:"#/definitions/<custom-ident>"}],description:"CSS transition property: all or property name"},"<quote>":{type:"string",enum:["open-quote","close-quote","no-open-quote","no-close-quote"],description:"CSS quote values for generated content"},"<counter-style-name>":{anyOf:[{$ref:"#/definitions/<custom-ident>"},{type:"string",enum:["decimal","decimal-leading-zero","lower-roman","upper-roman","lower-greek","lower-latin","upper-latin","armenian","georgian","lower-alpha","upper-alpha","disc","circle","square","none"]}],description:"CSS counter style: predefined or custom identifier"},"<ratio>":{type:"string",pattern:"^\\d+(\\.\\d+)?\\s*/\\s*\\d+(\\.\\d+)?$",description:"CSS ratio: number/number"},"<dasharray>":{type:"string",description:"CSS dash array for stroke-dasharray. Complex syntax with multiple length/percentage/number values cannot be fully validated with regex."},"<paint>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<color>"},{$ref:"#/definitions/<url>"}],description:"CSS paint values for SVG: none, color, URL, or context keywords"},"<overflow-wrap>":{type:"string",enum:["normal","break-word","anywhere"],description:"CSS overflow-wrap values (same as word-wrap)"},"<text-decoration-thickness>":{anyOf:[{$ref:"#/definitions/<auto>"},{$ref:"#/definitions/<positive-length>"},{$ref:"#/definitions/<positive-percentage>"},{type:"string",enum:["from-font"]}],description:"CSS text decoration thickness"},"<text-underline-offset>":{anyOf:[{$ref:"#/definitions/<auto>"},{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"}],description:"CSS text underline offset"},"<text-emphasis-style>":{anyOf:[{$ref:"#/definitions/<none>"},{type:"string",enum:["filled","open","dot","circle","double-circle","triangle","sesame"]},{$ref:"#/definitions/<string>"}],description:"CSS text emphasis style"},"<mask-composite>":{type:"string",enum:["add","subtract","intersect","exclude"],description:"CSS mask composite operation values"},"<mask-mode>":{type:"string",enum:["alpha","luminance","match-source"],description:"CSS mask mode values"},"<clip-path>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<url>"},{$ref:"#/definitions/<basic-shape>"}],description:"CSS clip-path: none, URL, or basic shape"},"<shape-outside>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"},{$ref:"#/definitions/<basic-shape>"}],description:"CSS shape-outside: none, image, or basic shape"},"<intrinsic-size-keyword>":{type:"string",enum:["auto","min-content","max-content","fit-content"],description:"CSS intrinsic sizing keywords"},"<step-position>":{type:"string",enum:["jump-start","jump-end","jump-none","jump-both","start","end"],description:"CSS step position for steps() timing function"},"<system-color>":{type:"string",enum:["AccentColor","AccentColorText","ActiveText","ButtonBorder","ButtonFace","ButtonText","Canvas","CanvasText","Field","FieldText","GrayText","Highlight","HighlightText","LinkText","Mark","MarkText","SelectedItem","SelectedItemText","VisitedText"],description:"CSS system colors"},"<deprecated-system-color>":{type:"string",enum:["ActiveBorder","ActiveCaption","AppWorkspace","Background","ButtonHighlight","ButtonShadow","CaptionText","InactiveBorder","InactiveCaption","InactiveCaptionText","InfoBackground","InfoText","Menu","MenuText","Scrollbar","ThreeDDarkShadow","ThreeDFace","ThreeDHighlight","ThreeDLightShadow","ThreeDShadow","Window","WindowFrame","WindowText"],description:"CSS deprecated system colors"},"<bg-size>":{anyOf:[{$ref:"#/definitions/<positive-length-percentage>"},{type:"string",enum:["auto","cover","contain"]},{type:"string",pattern:"^(auto|calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))(\\s+(auto|calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))?)$",description:"complex syntax with multiple values that cannot be fully validated with regex"}],description:"CSS background-size values"},"<bg-position>":{type:"string",description:"CSS background-position values. Complex syntax with multiple position values and combinations cannot be fully validated with regex."},"<bg-clip>":{anyOf:[{$ref:"#/definitions/<visual-box>"},{type:"string",enum:["text"]}],description:"CSS background-clip values"},"<bg-image>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"}],description:"CSS background-image values"},"<hue>":{anyOf:[{$ref:"#/definitions/<number>"},{$ref:"#/definitions/<angle>"}],description:"CSS hue value: number or angle"},"<radial-shape>":{type:"string",enum:["circle","ellipse"],description:"CSS radial gradient shape"},"<radial-extent>":{type:"string",enum:["closest-corner","closest-side","farthest-corner","farthest-side"],description:"CSS radial gradient extent"},"<side-or-corner>":{type:"string",pattern:"^(left|right|top|bottom)$|^(left|right)\\s+(top|bottom)$|^(top|bottom)\\s+(left|right)$",description:"CSS gradient side or corner direction"},"<color-stop-length>":{anyOf:[{$ref:"#/definitions/<length-percentage>"},{type:"string",pattern:"^\\d+(\\.\\d+)?%\\s+\\d+(\\.\\d+)?%$"}],description:"CSS color stop length: single or double length-percentage"},"<color-stop-angle>":{anyOf:[{$ref:"#/definitions/<angle-percentage>"},{type:"string",pattern:"^\\d+(\\.\\d+)?deg\\s+\\d+(\\.\\d+)?deg$"}],description:"CSS color stop angle: single or double angle-percentage"},"<masking-mode>":{type:"string",enum:["alpha","luminance","match-source"],description:"CSS masking mode values"},"<mask-reference>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"},{$ref:"#/definitions/<url>"}],description:"CSS mask reference values"},"<mask>":{type:"string",description:"CSS mask shorthand. Complex syntax combining multiple mask layers with mask-image, mask-mode, mask-position, mask-size, mask-repeat, mask-origin, mask-clip, and mask-composite cannot be fully validated with regex."},"<outline-line-style>":{type:"string",enum:["none","dotted","dashed","solid","double","groove","ridge","inset","outset"],description:"CSS outline line style values"},"<counter-name>":{anyOf:[{$ref:"#/definitions/<custom-ident>"},{type:"string",enum:["list-item"]}],description:"CSS counter name: custom identifier or list-item"},"<symbol>":{anyOf:[{$ref:"#/definitions/<string>"},{$ref:"#/definitions/<image>"},{$ref:"#/definitions/<custom-ident>"}],description:"CSS symbol values for counters"},"<symbols-type>":{type:"string",enum:["cyclic","numeric","alphabetic","symbolic","fixed"],description:"CSS symbols() function type"},"<feature-tag-value>":{type:"string",description:"CSS font feature tag value. Complex syntax with string and optional integer/keyword cannot be fully validated with regex."},"<east-asian-variant-values>":{type:"string",enum:["jis78","jis83","jis90","jis04","simplified","traditional"],description:"CSS East Asian variant values"},"<east-asian-width-values>":{type:"string",enum:["full-width","proportional-width"],description:"CSS East Asian width values"},"<numeric-figure-values>":{type:"string",enum:["lining-nums","oldstyle-nums"],description:"CSS numeric figure values"},"<numeric-fraction-values>":{type:"string",enum:["diagonal-fractions","stacked-fractions"],description:"CSS numeric fraction values"},"<numeric-spacing-values>":{type:"string",enum:["proportional-nums","tabular-nums"],description:"CSS numeric spacing values"},"<common-lig-values>":{type:"string",enum:["common-ligatures","no-common-ligatures"],description:"CSS common ligature values"},"<discretionary-lig-values>":{type:"string",enum:["discretionary-ligatures","no-discretionary-ligatures"],description:"CSS discretionary ligature values"},"<historical-lig-values>":{type:"string",enum:["historical-ligatures","no-historical-ligatures"],description:"CSS historical ligature values"},"<contextual-alt-values>":{type:"string",enum:["contextual","no-contextual"],description:"CSS contextual alternates values"},"<composite-style>":{type:"string",enum:["clear","copy","source-over","source-in","source-out","source-atop","destination-over","destination-in","destination-out","destination-atop","xor"],description:"CSS composite style values"},"<compositing-operator>":{type:"string",enum:["add","subtract","intersect","exclude"],description:"CSS compositing operator values"},"<axis>":{type:"string",enum:["block","inline","x","y"],description:"CSS axis values"},"<scroller>":{type:"string",enum:["root","nearest","self"],description:"CSS scroller values"},"<try-size>":{type:"string",enum:["most-width","most-height","most-block-size","most-inline-size"],description:"CSS try size values"},"<try-tactic>":{type:"string",enum:["flip-block","flip-inline","flip-start"],description:"CSS try tactic values"},"<font>":{type:"string",description:"CSS font shorthand. Complex syntax combining font-style, font-variant, font-weight, font-size/line-height, and font-family cannot be fully validated with regex."},"<font-variant>":{type:"string",description:"CSS font-variant shorthand. Complex syntax combining normal, small-caps, and various feature values cannot be fully validated with regex."},"<flex-direction>":{type:"string",enum:["row","row-reverse","column","column-reverse"],description:"CSS flex-direction values"},"<gap>":{type:"string",pattern:"^(normal|0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))(\\s|$){1,2}",description:"CSS gap values"},"<padding>":{type:"string",pattern:"^((0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s*){1,4}$",description:"CSS padding values"},"<padding-top>":{$ref:"#/definitions/<positive-length-percentage>",description:"CSS padding-top values"},unevaluatedProperties:!1,type:"object"},"title--unrestricted-root":"CSS Value Definitions","description--unrestricted-root":"Individual JSON Schema definitions for CSS value types, suitable for format registration","definitions--unrestricted-root":{"<positive-value>":{type:"string",pattern:"^[^-]",description:"CSS positive value"},"<length>":{oneOf:[{$ref:"#/definitions/<basic-math-functions-without-percentage>"},{type:"string",pattern:"^(0|(-?\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q)))$"}],description:"CSS numeric length with all valid units"},"<positive-length>":{allOf:[{$ref:"#/definitions/<positive-value>"},{$ref:"#/definitions/<length>"}],description:"CSS positive numeric length with all valid units"},"<percentage>":{oneOf:[{$ref:"#/definitions/<basic-math-functions>"},{type:"string",pattern:"^-?\\d*\\.?\\d+%$"}],description:"Number followed by %"},"<positive-percentage>":{allOf:[{$ref:"#/definitions/<positive-value>"},{$ref:"#/definitions/<percentage>"}],description:"Positive number followed by %"},"<length-percentage>":{anyOf:[{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"}],description:"Accepts both <length> and <percentage>"},"<positive-length-percentage>":{anyOf:[{$ref:"#/definitions/<positive-length>"},{$ref:"#/definitions/<positive-percentage>"}],description:"Accepts both <positive-length> and <positive-percentage>"},"<auto>":{type:"string",enum:["auto"],description:"CSS auto keyword"},"<length-percentage-auto>":{anyOf:[{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"},{$ref:"#/definitions/<auto>"}],description:"CSS length, percentage, or auto"},"<positive-length-percentage-auto>":{anyOf:[{$ref:"#/definitions/<positive-length>"},{$ref:"#/definitions/<positive-percentage>"},{$ref:"#/definitions/<auto>"}],description:"CSS positive length, positive percentage, or auto"},"<number>":{oneOf:[{$ref:"#/definitions/<all-math-functions-without-percentage>"},{type:"string",pattern:"^-?\\d*\\.?\\d+$"}],description:"Decimal or integer number"},"<positive-number>":{allOf:[{$ref:"#/definitions/<positive-value>"},{$ref:"#/definitions/<number>"}],description:"Positive decimal or integer number"},"<integer>":{oneOf:[{$ref:"#/definitions/<all-math-functions-without-percentage>"},{type:"string",pattern:"^-?\\d+$"}],description:"Whole numbers only"},height:{anyOf:[{$ref:"#/definitions/<auto>"},{$ref:"#/definitions/<positive-length-percentage>"},{type:"string",enum:["min-content","max-content"]}],description:"CSS height value"},"<angle>":{oneOf:[{$ref:"#/definitions/<all-math-functions>"},{type:"string",pattern:"^-?\\d*\\.?\\d+(deg|rad|grad|turn)$"}],description:"Used in rotation, direction, etc."},"<time>":{oneOf:[{$ref:"#/definitions/<basic-math-functions-without-percentage>"},{type:"string",pattern:"^-?\\d*\\.?\\d+(ms|s)$"}],description:"CSS durations (s, ms)"},"<resolution>":{type:"string",pattern:"^-?\\d*\\.?\\d+(dpi|dpcm|dppx|x)$",description:"Screen density/resolution units"},"<frequency>":{oneOf:[{$ref:"#/definitions/<basic-math-functions>"},{type:"string",pattern:"^-?\\d*\\.?\\d+(Hz|kHz)$"}],description:"Used in aural CSS or media queries"},"<dimension>":{type:"string",pattern:"^-?\\d*\\.?\\d+[a-zA-Z]+$",description:"Generic dimension (unit required)"},"<percentage-or-number>":{oneOf:[{$ref:"#/definitions/<number>"},{$ref:"#/definitions/<percentage>"}],description:"Matches numbers or percentages"},"<custom-ident>":{type:"string",pattern:"^[a-zA-Z_][\\w-]*$",description:"CSS identifiers (excluding keywords)"},"<ident>":{type:"string",pattern:"^[a-zA-Z_][\\w-]*$",description:"Same as <custom-ident>"},"<string>":{type:"string",pattern:`^"(?:[^"\\\\]|\\\\.)*"|'(?:[^'\\\\]|\\\\.)*'$`,description:"Quoted strings with escapes"},"<url>":{type:"string",pattern:`^url\\((?:'[^']*'|"[^"]*"|[^'"]*)\\)$`,description:"Matches url(...) with optional quotes"},"<hex-color>":{type:"string",pattern:"^#([a-fA-F0-9]{3}|[a-fA-F0-9]{4}|[a-fA-F0-9]{6}|[a-fA-F0-9]{8})$",description:"Hexadecimal color values: #rgb, #rgba, #rrggbb, #rrggbbaa"},"<rgb-color>":{type:"string",pattern:"^rgba?\\(\\s*\\d+\\s*,\\s*\\d+\\s*,\\s*\\d+(\\s*,\\s*\\d*(\\.\\d+)?)?\\s*\\)$",description:"RGB/RGBA functional notation. Note: This regex cannot fully validate percentage values or modern space-separated syntax."},"<hsl-color>":{type:"string",pattern:"^hsla?\\(\\s*\\d+\\s*,\\s*\\d+%\\s*,\\s*\\d+%(\\s*,\\s*\\d*(\\.\\d+)?)?\\s*\\)$",description:"HSL/HSLA functional notation. Note: This regex cannot fully validate modern space-separated syntax or angle units for hue."},"<named-color>":{type:"string",enum:["transparent","currentColor","aliceblue","antiquewhite","aqua","aquamarine","azure","beige","bisque","black","blanchedalmond","blue","blueviolet","brown","burlywood","cadetblue","chartreuse","chocolate","coral","cornflowerblue","cornsilk","crimson","cyan","darkblue","darkcyan","darkgoldenrod","darkgray","darkgrey","darkgreen","darkkhaki","darkmagenta","darkolivegreen","darkorange","darkorchid","darkred","darksalmon","darkseagreen","darkslateblue","darkslategray","darkslategrey","darkturquoise","darkviolet","deeppink","deepskyblue","dimgray","dimgrey","dodgerblue","firebrick","floralwhite","forestgreen","fuchsia","gainsboro","ghostwhite","gold","goldenrod","gray","grey","green","greenyellow","honeydew","hotpink","indianred","indigo","ivory","khaki","lavender","lavenderblush","lawngreen","lemonchiffon","lightblue","lightcoral","lightcyan","lightgoldenrodyellow","lightgray","lightgrey","lightgreen","lightpink","lightsalmon","lightseagreen","lightskyblue","lightslategray","lightslategrey","lightsteelblue","lightyellow","lime","limegreen","linen","magenta","maroon","mediumaquamarine","mediumblue","mediumorchid","mediumpurple","mediumseagreen","mediumslateblue","mediumspringgreen","mediumturquoise","mediumvioletred","midnightblue","mintcream","mistyrose","moccasin","navajowhite","navy","oldlace","olive","olivedrab","orange","orangered","orchid","palegoldenrod","palegreen","paleturquoise","palevioletred","papayawhip","peachpuff","peru","pink","plum","powderblue","purple","rebeccapurple","red","rosybrown","royalblue","saddlebrown","salmon","sandybrown","seagreen","seashell","sienna","silver","skyblue","slateblue","slategray","slategrey","snow","springgreen","steelblue","tan","teal","thistle","tomato","turquoise","violet","wheat","white","whitesmoke","yellow","yellowgreen"],description:"CSS named colors including transparent and currentColor"},"<color>":{anyOf:[{$ref:"#/definitions/<hex-color>"},{$ref:"#/definitions/<rgb-color>"},{$ref:"#/definitions/<hsl-color>"},{$ref:"#/definitions/<named-color>"}],description:"CSS color values supporting hex, rgb/rgba, hsl/hsla, and named colors"},"<image>":{anyOf:[{$ref:"#/definitions/<url>"},{type:"string",pattern:"^(linear-gradient|radial-gradient|conic-gradient|repeating-linear-gradient|repeating-radial-gradient|repeating-conic-gradient)\\(.*\\)$",description:"Gradient functions - arguments cannot be fully validated with regex"},{type:"string",pattern:"^image\\(.*\\)$",description:"Image function - arguments cannot be fully validated with regex"}],description:"CSS image values including URLs, gradients, and image() functions"},"<position>":{anyOf:[{$ref:"#/definitions/<position-one>"},{$ref:"#/definitions/<position-two>"},{$ref:"#/definitions/<position-four>"}],description:"Single position value. Full position syntax with multiple values and combinations requires complex parsing that cannot be fully validated with regex."},"<position-one>":{anyOf:[{enum:["left","center","right","top","bottom","x-start","x-end","y-start","y-end","block-start","block-end","inline-start","inline-end"]},{$ref:"#/definitions/<positive-length-percentage>"}]},"<position-two>":{anyOf:[{pattern:"^(((left|center|right|x-start|x-end)\\s(top|center|bottom|y-start|y-end))|((top|center|bottom|y-start|y-end)\\s(left|center|right|x-start|x-end)))$"},{pattern:"^(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))$"},{pattern:"^((block-start|center|block-end)\\s(inline-start|center|inline-end))|((inline-start|center|inline-end)\\s(block-start|center|block-end))$"},{pattern:"^((start|center|end)\\s*){2}$"}]},"<position-four>":{anyOf:[{pattern:"^((left|right|x-start|x-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(top|bottom|y-start|y-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))|((top|bottom|y-start|y-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(left|right|x-start|x-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))$"},{pattern:"^((block-start|block-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(inline-start|inline-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))|((inline-start|inline-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s(block-start|block-end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))$"},{pattern:"^((start|end)\\s(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))\\s*){2}$"}]},"<transform-function>":{type:"string",pattern:"^(matrix|matrix3d|perspective|rotate|rotate3d|rotateX|rotateY|rotateZ|scale|scale3d|scaleX|scaleY|scaleZ|skew|skewX|skewY|translate|translate3d|translateX|translateY|translateZ)\\(.*\\)$",description:"Transform functions like rotate(), translate(), scale(). Function arguments cannot be fully validated with regex as they require parsing of nested expressions."},"<var()>":{type:"string",pattern:"(?:^|[^a-zA-Z0-9_])var\\s*\\(\\s*--.+\\)",description:"Any CSS value string containing at least one var() reference. Validation is deferred to runtime (value type substitution with css-tree)."},"<basic-math-functions>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs)\\((?!.*\\/\\s*0\\b).+\\)$",description:"Basic CSS math functions that work with any value type. Percentages allowed where contextually appropriate."},"<basic-math-functions-without-percentage>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs)\\((?!.*\\/\\s*0\\b)[^%]+\\)$",description:"Basic CSS math functions without percentages or division by zero."},"<basic-math-functions-with-percentage>":{type:"string",pattern:"(calc|min|max|clamp|round|mod|rem|abs)\\([^)]*%[^)]*\\)",description:"Detects if any basic math function contains percentages"},"<all-math-functions>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs|sin|cos|tan|asin|acos|atan|atan2|pow|sqrt|hypot|log|exp|sign)\\((?!.*\\/\\s*0\\b).+\\)$",description:"All CSS math functions - basic, trigonometric, and advanced mathematical functions."},"<all-math-functions-without-percentage>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs|sin|cos|tan|asin|acos|atan|atan2|pow|sqrt|hypot|log|exp|sign)\\((?!.*\\/\\s*0\\b)(?!.*%).+\\)$",description:"All CSS math functions without percentages or division by zero."},"<attr()>":{type:"string",pattern:"^attr\\(.*\\)$",description:"CSS attr() function. Cannot fully validate fallback values and type hints with regex."},"<image-set()>":{type:"string",pattern:"^image-set\\(.*\\)$",description:"CSS image-set() function. Cannot parse comma-separated URLs and resolution descriptors with regex."},"<basic-shape>":{type:"string",pattern:"^(inset|rect|xywh|circle|ellipse|polygon|path|shape)\\(.*\\)$",description:"CSS basic shape functions. Shape-specific arguments cannot be fully validated with regex."},"<filter-function>":{type:"string",pattern:"^(blur|brightness|contrast|drop-shadow|grayscale|hue-rotate|invert|opacity|saturate|sepia|url)\\(([^\\(\\)]*|(\\([^\\(\\)]*\\)))+\\)$",description:"CSS filter functions. Function arguments cannot be fully validated with regex."},"<filter-value-list>":{type:"string",pattern:"^((blur|brightness|contrast|drop-shadow|grayscale|hue-rotate|invert|opacity|saturate|sepia|url)\\(([^\\(\\)]*|(\\([^\\(\\)]*\\)))+\\))(\\s+(blur|brightness|contrast|drop-shadow|grayscale|hue-rotate|invert|opacity|saturate|sepia|url)\\(([^\\(\\)]*|(\\([^\\(\\)]*\\)))+\\))*$",description:"CSS filter functions - value separated list. Function arguments cannot be fully validated with regex."},"<filter>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<filter-value-list>"}],description:"CSS filter value"},"<line-width>":{anyOf:[{$ref:"#/definitions/<positive-length>"},{type:"string",enum:["thin","medium","thick"]}],description:"CSS line width: length values or predefined keywords"},"<line-style>":{type:"string",enum:["none","hidden","dotted","dashed","solid","double","groove","ridge","inset","outset"],description:"CSS line style keywords"},"<global-values>":{type:"string",enum:["inherit","initial","unset","revert","revert-layer"],description:"Global values available for any CSS property"},"<flex>":{type:"string",pattern:"^\\d*\\.?\\d+fr$",description:"CSS flex unit for grid and flexbox"},"<none>":{type:"string",enum:["none"],description:"CSS none keyword"},"<normal>":{type:"string",enum:["normal"],description:"CSS normal keyword"},"<shadow>":{anyOf:[{$ref:"#/definitions/<none>"},{type:"string",pattern:"^(inset\\s+)?(-?\\d+\\w*\\s+){2,4}(#[a-fA-F0-9]{3,8}|rgba?\\(.*\\)|hsla?\\(.*\\)|[a-zA-Z]+)?$"}],description:"CSS shadow value (box-shadow, text-shadow). Complex syntax with optional inset, multiple length values, and color cannot be fully validated with regex."},"<font-family>":{anyOf:[{$ref:"#/definitions/<family-name>"},{$ref:"#/definitions/<generic-family>"},{type:"string",pattern:`^['"]?([^\\d][\\p{L}\\s\\-_\\d]*)['"]?(,\\s*['"]?([^\\d][\\p{L}\\s\\-_\\d]*)['"]?)*$`,description:"Complex family name with multiple family names separated by commas"}],description:"CSS font family: generic families, quoted family names, or unquoted family names"},"<font-weight>":{anyOf:[{type:"string",enum:["normal","bold","bolder","lighter"]},{type:"string",pattern:"^(100|200|300|400|500|600|700|800|900)$"}],description:"CSS font weight: keywords or numeric values"},"<font-style>":{anyOf:[{type:"string",enum:["normal","italic","oblique"]},{type:"string",pattern:"^oblique\\s+\\d+deg$"}],description:"CSS font style: keywords or oblique with angle"},"<font-size>":{anyOf:[{$ref:"#/definitions/<absolute-size>"},{$ref:"#/definitions/<relative-size>"},{$ref:"#/definitions/<positive-length-percentage>"},{type:"string",enum:["math"]}],description:"CSS font size: length, percentage, or keyword values"},"<display>":{anyOf:[{type:"string",enum:["table-row-group","table-header-group","table-footer-group","table-row","table-cell","table-column-group","table-column","table-caption","ruby-base","ruby-text","ruby-base-container","ruby-text-container","contents","none","inline-block","inline-table","inline-flex","inline-grid"]},{type:"string",description:"complex display value that cannot be fully validated with regex"}],description:"CSS display property values"},"<overflow-block>":{type:"string",enum:["visible","hidden","clip","scroll","auto"],description:"CSS overflow-x and overflow-y property values"},"<overflow>":{type:"string",pattern:"^(visible|hidden|scroll|auto|clip)(\\s+(visible|hidden|scroll|auto|clip))?$",description:"CSS overflow property values"},"<text-align>":{type:"string",enum:["left","right","center","justify","start","end","match-parent"],description:"CSS text-align property values"},"<align-items>":{anyOf:[{$ref:"#/definitions/<normal>"},{type:"string",enum:["stretch"]},{$ref:"#/definitions/<baseline-position>"},{type:"string",pattern:"^((safe|unsafe)\\s+)?(center|start|end|self-start|self-end|flex-start|flex-end)$"}],description:"CSS align-items values"},"<vertical-align>":{anyOf:[{type:"string",enum:["baseline","sub","super","text-top","text-bottom","middle","top","bottom"]},{$ref:"#/definitions/<length>"},{$ref:"#/definitions/<percentage>"}],description:"CSS vertical-align: keywords, length, or percentage"},"<border-radius>":{type:"string",pattern:"^(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)\\s*){1,4}(/\\s*(0|(calc|min|max|clamp|round|mod|rem|abs)\\(.+\\)|\\d+(\\.\\d+)?(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)\\s*){1,4})?$",description:"CSS border-radius shorthand. Complex syntax combining multiple radius values cannot be fully validated with regex."},"<border-top-left-radius>":{type:"string",pattern:"^(calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))(\\s+(calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%)))?$",description:"CSS border-top-left-radius shorthand"},"<border-style>":{type:"string",pattern:"^(none|hidden|dotted|dashed|solid|double|groove|ridge|inset|outset)(\\s+(none|hidden|dotted|dashed|solid|double|groove|ridge|inset|outset)){0,3}$",description:"CSS border-style shorthand"},"<border-width>":{type:"s