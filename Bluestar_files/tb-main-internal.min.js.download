itions/<string>"}],description:"CSS text emphasis style"},"<mask-composite>":{type:"string",enum:["add","subtract","intersect","exclude"],description:"CSS mask composite operation values"},"<mask-mode>":{type:"string",enum:["alpha","luminance","match-source"],description:"CSS mask mode values"},"<clip-path>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<url>"},{$ref:"#/definitions/<basic-shape>"}],description:"CSS clip-path: none, URL, or basic shape"},"<shape-outside>":{anyOf:[{$ref:"#/definitions/<none>"},{$ref:"#/definitions/<image>"},{$ref:"#/definitions/<basic-shape>"}],description:"CSS shape-outside: none, image, or basic shape"},"<intrinsic-size-keyword>":{type:"string",enum:["auto","min-content","max-content","fit-content"],description:"CSS intrinsic sizing keywords"},"<step-position>":{type:"string",enum:["jump-start","jump-end","jump-none","jump-both","start","end"],description:"CSS step position for steps() timing function"},"<system-color>":{type:"string",enum:["AccentColor","AccentColorText","ActiveText","ButtonBorder","ButtonFace","ButtonText","Canvas","CanvasText","Field","FieldText","GrayText","Highlight","HighlightText","LinkText","Mark","MarkText","SelectedItem","SelectedItemText","VisitedText"],description:"CSS system colors"},"<deprecated-system-color>":{type:"string",enum:["ActiveBorder","ActiveCaption","AppWorkspace","Background","ButtonHighlight","ButtonShadow","CaptionText","InactiveBorder","InactiveCaption","InactiveCaptionText","InfoBackground","InfoText","Menu","MenuText","Scrollbar","ThreeDDarkShadow","ThreeDFace","ThreeDHighlight","ThreeDLightShadow","ThreeDShadow","Window","WindowFrame","WindowText"],description:"CSS deprecated system colors"},"<bg-size>":{anyOf:[{$ref:"#/definitions/<positive-length-percentage>"},{type:"string",enum:["auto","cover","contain"]},{type:"string",pattern:"^(auto|calc|min|max|clamp|round|mod|rem|abs\\([^,]+\\)|\\d*\\.?\\d+(px|spx|em|ex|ch|rem|lh|rlh|vw|vh|vmin|vmax|cm|mm|in|pt|pc|q|%))(\\s+(aut