rder-width shorthand"},"<border>":{type:"string",pattern:"^(?!.*\\/\\s*0).*$",description:"CSS border shorthand with division by zero rejection in calc expressions. Detailed syntax validation handled by css-tree."},"<background>":{type:"string",description:"CSS background shorthand. Extremely complex syntax combining multiple background layers with image, position, size, repeat, attachment, origin, clip, and color cannot be fully validated with regex."},"<transition>":{type:"string",description:"CSS transition shorthand. Complex syntax combining property, duration, timing-function, and delay cannot be fully validated with regex."},"<animation>":{type:"string",description:"CSS animation shorthand. Complex syntax combining name, duration, timing-function, delay, iteration-count, direction, fill-mode, and play-state cannot be fully validated with regex."},"<grid-template>":{type:"string",description:"CSS grid template properties. Complex syntax with track sizes, line names, and repeat functions cannot be fully validated with regex."},"<flex-shorthand>":{type:"string",description:"CSS flex shorthand combining flex-grow, flex-shrink, and flex-basis. Complex parsing required to validate the various combinations."},"<blend-mode>":{type:"string",enum:["normal","multiply","screen","overlay","darken","lighten","color-dodge","color-burn","hard-light","soft-light","difference","exclusion","hue","saturation","color","luminosity"],description:"CSS blend mode values for mix-blend-mode and background-blend-mode"},"<mix-blend-mode>":{$ref:"#/definitions/<blend-mode>",description:"CSS mix-blend-mode property values"},"<background-blend-mode>":{$ref:"#/definitions/<blend-mode>",description:"CSS background-blend-mode property values"},"<timing-function>":{anyOf:[{type:"string",enum:["ease","ease-in","ease-out","ease-in-out","linear","step-start","step-end"]},{type:"string",pattern:"^cubic-bezier\\(\\s*-?\\d*\\.?\\d+\\s*,\\s*-?\\d*\\.?\\d+\\s*,\\s*-?\\d*\\.?\\d+\\s*,\\s*-?\\d*\\.?\\d+\\