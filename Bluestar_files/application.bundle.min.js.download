-item-button disabled" type="button"> <i class="glyphicon-duplicate-next-sm"></i> <span> {{::\'product.SAVE_AND_DUPLICATE_TITLE\' | translate}} </span> </button> </li> <li class="drop-down-item" ng-if="!productVM.isNewOrCopyProduct"> <button class="drop-down-item-button danger" data-hook="product-delete" ng-click="$emit(\'CLOSE-DROP-DOWN\'); productVM.onRemove()" type="button"> <i class="glyphicon-delete-icon"></i> <span> {{::\'product.DELETE_PRODUCT_LINK\' | translate}} </span> </button> </li> </ul> </dropdown-button> <button id="product-cancel" data-hook="product-cancel" class="wix-button action close is-cancel" ng-click="productVM.onCancel()" ng-class="{\'wix-button-invert is-button-outline\': headerScope.isInverted, \'wix-button-invert-light\': !headerScope.isInverted}" type="button"> {{::\'product.CANCEL_TITLE\' | translate}} </button> <button type="submit" id="product-save" data-hook="product-save" class="wix-button action save" ng-class="{\'wix-button-invert\': headerScope.isInverted, \'wix-button\': !headerScope.isInverted}"> {{::\'product.SAVE_BUTTON\' | translate}} </button> </header-actions> </page-header> <section class="loading-state" ng-if="!productVM.isLoaded"> <div class="loader"></div> <h3 class="header-title"> {{::\'LOADING_TITLE\' | translate}} </h3> </section> <list-browser data-hook="product-page-list-browser" state-manager="productListStateManagerGqlForListBrowserAdapter" ng-click="productVM.productNavigationClick(productVM.product.id)"></list-browser> <section class="content-scroll-container" scrollable="content"> <section class="header-hero" ng-if="productVM.isLoaded" data-hook="product-header" ng-class="{\'has-image\': productVM.product.media.length}"> <img wix-media="productVM.product.media[0]" height="100" width="400" class="img-strip" ng-if="productVM.product.media.length" data-hook="product-image-header"/> </section> <section ng-if="productVM.isLoaded" class="content"> <div class="wix-grid"> <div class="row clear-edge-gutter"> <div class